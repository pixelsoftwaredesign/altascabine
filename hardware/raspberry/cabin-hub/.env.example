# --- LLM libre facultatif (niveau « génération libre ») ---
# Style 1 — Ollama local (recommandé, 100 % privé) :
#LLM_STYLE=ollama
#OLLAMA_BASE=http://localhost:11434
#OLLAMA_MODEL=llama3.1
#
# Style 2 — API compatible OpenAI (ex : llama.cpp server, LM Studio, GPT) :
#LLM_STYLE=openai
#LLM_BASE=https://votre-serveur/v1
#LLM_KEY=sk-...
#LLM_MODEL=gpt-4o-mini
#
# LLM_TIMEOUT (secondes) avant repli sur la base privée (gemma4:26b est lent au 1er appel) :
#LLM_TIMEOUT=180
# LLM_MAX_TOKENS (génération max, pensées incluses) :
#LLM_MAX_TOKENS=600